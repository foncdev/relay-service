# 앞에 / 가 없어야 web/node_modules 처럼 하위 것도 잡힌다.
**/node_modules/

# 설정 (토큰이 들어간다)
.env
.env.local

# 계정·체크리스트·알림. 개인 정보가 들어 있다.
# 백업 파일(.bak)까지 함께 막는다.
data/

# 빌드·로그. web/ 아래 것도 함께 잡힌다.
**/dist/
*.tsbuildinfo
*.log

# 에디터·OS
.DS_Store
.idea/
.vscode/

# 로컬 전용 compose 설정.
# 모노레포로 함께 받았을 때 옆 저장소의 안경앱을 붙이는 데 쓴다.
docker-compose.override.yml
