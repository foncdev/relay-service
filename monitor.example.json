{
  "refreshSeconds": 30,
  "groupLabel": "job",
  "groups": {
    "운영 웹": ["web-*"],
    "DB": ["db-*"],
    "스테이징": ["stg-*"]
  },
  "services": { "query": "up", "nameLabel": "job" },
  "stats": [
    {
      "group": "쇼핑몰", "item": "오늘", "key": "orders", "label": "주문", "unit": "건",
      "query": "sum(increase(shop_orders_total[1d]))",
      "warn": 500, "crit": 200, "lowerIsWorse": true
    },
    {
      "group": "쇼핑몰", "item": "오늘", "key": "returns", "label": "반품", "unit": "건",
      "datasourceUid": "MYSQL_DATASOURCE_UID",
      "sql": "SELECT count(*) FROM returns WHERE created_at >= CURDATE()",
      "warn": 50, "crit": 100
    },
    {
      "group": "쇼핑몰", "item": "오늘", "key": "payment_fail", "label": "결제 실패율", "unit": "%", "max": 10,
      "query": "sum(increase(shop_payment_failed_total[1d])) / sum(increase(shop_payment_total[1d])) * 100",
      "warn": 3, "crit": 5
    }
  ]
}
