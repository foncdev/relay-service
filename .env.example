# relay-service 설정. 복사해서 .env로 쓴다.
#   cp .env.example .env

PORT=4100
HOST=0.0.0.0

# --- 인증 ---
#
# 계정(아이디·비밀번호)은 첫 접속 때 웹에서 만든다. 여기 적는 토큰들은
# agent가 붙을 때 쓰는 것이고, 사람 로그인과는 별개다.

# agent-cli(맥)가 접속할 때 제시하는 토큰. 비워두면 agent 접속을 받지 않는다.
#   만들기: openssl rand -hex 24
RELAY_AGENT_TOKEN=

# 레거시 클라이언트 키. 로그인 없이 셸까지 모든 경로를 여는 마스터 키다.
# 지금은 웹·안경이 계정 로그인을 쓰므로 필요 없으면 비워 둔다.
# 쓴다면 24자 이상이어야 한다(짧으면 받지 않는다).
RELAY_CLIENT_KEY=

# terminal-agent가 접속할 때 쓰는 토큰.
# agent-cli와 따로 둔다 — 셸을 여는 쪽이라 한쪽이 새도 번지지 않게.
# 비워두면 terminal-agent 접속을 아예 받지 않는다.
RELAY_TERMINAL_TOKEN=

# 외부 서비스가 알림만 넣을 때 쓰는 키 (POST /hooks/notify).
# 클라이언트 키와 반드시 다르게 둔다 — 그건 세션·파일·셸까지 여는
# 마스터라 남의 자동화나 웹훅에 건네면 안 된다. 이 키로는 알림 추가만
# 된다. 비워두면 훅이 닫힌다(503).
RELAY_HOOK_KEY=

# 발급한 로그인 토큰의 유효기간(일).
RELAY_TOKEN_TTL_DAYS=30

# --- 정적 파일 ---
#
# 두 경로가 다르다. 헷갈리면 /web에 엉뚱한 앱이 뜬다.

# 브라우저용 관리 UI. /web 에서 서빙한다. 이 저장소 안에 있다.
RELAY_WEB_ROOT=./web/dist

# 안경앱. 루트(/)에서 서빙한다 — G2가 QR로 루트를 열기 때문이다.
RELAY_GLASSES_ROOT=../glasses-g2/dist

# --- 기타 ---

# 계정·체크리스트·알림이 저장되는 곳.
RELAY_DATA_DIR=./data

# 분당 요청 상한 (무차별 대입 방어)
RELAY_RATE_LIMIT=300

# IP당 분당 로그인·초기 설정 시도.
RELAY_LOGIN_LIMIT=10

# 리버스 프록시(Caddy·nginx) 뒤에 둘 때만 1로 켠다. 실제 IP를
# X-Forwarded-For에서 읽는다. 프록시 없이 켜면 누구나 IP를 바꿔
# 시도 제한을 피한다.
RELAY_TRUST_PROXY=

# 서버가 만드는 글(할 일 알림 제목·안경 첫 줄·오류 문구)의 언어. ko(기본) 또는 en.
# 폰·안경이 모두 같은 글을 보므로 폰 언어와 같게 둔다. 다르면 폰에서 한 일에
# 배너가 한 번 더 뜬다(폰은 알림 제목으로 자기가 한 일을 가려낸다).
RELAY_LANG=ko
